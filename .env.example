# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://127.0.0.1:3000
# Deine Haupt-Domain (für Subdomain-Kalender, z.B. "adventskalender.de")
# Kunden bekommen dann: ihr-slug.adventskalender.de
BASE_DOMAIN=localhost
TIMEZONE=Europe/Berlin

# Datenbank (MySQL / MariaDB)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=adventskalender

# Admin-Login (Schenker "Stibe")
ADMIN_USERNAME=Stibe
ADMIN_PASSWORD=change-me-please

# Sicherheit
JWT_SECRET=change-this-to-a-long-random-string

# E-Mail Versand (SMTP) für Registrierung
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=dein_ethereal_user@ethereal.email
SMTP_PASS=dein_ethereal_pass
SMTP_FROM="Adventskalender" <noreply@adventskalender.local>

# Push-Benachrichtigungen: Kontaktadresse, die Apple/Google/Mozilla bei Problemen
# mit dem Versand anschreiben können (mailto: oder https:). Fehlt sie, wird die
# Adresse aus SMTP_FROM verwendet.
VAPID_CONTACT=mailto:admin@deine-domain.ch

# Stripe Payment
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Einmalpreis je Wichtel-Runde bzw. Wichteltür (alle PRO-Funktionen), in Rappen/Cent
STRIPE_CURRENCY=chf
STRIPE_MODULE_AMOUNT=450

# Spotify (Gemeinsame Playlist) – Developer App unter https://developer.spotify.com/dashboard
# Als Redirect URI dort exakt eintragen: <BASE_URL>/api/spotify/callback
# (lokal: http://127.0.0.1:3000/api/spotify/callback – Spotify erlaubt kein "localhost")
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional, falls abweichend von BASE_URL:
# SPOTIFY_REDIRECT_URI=https://deine-domain.ch/api/spotify/callback
