{
  "name": "adventskalender-wichteln-app",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.20",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "configure": "node configure.js",
    "build:android": "eas build -p android --profile production",
    "build:ios": "eas build -p ios --profile production",
    "build:preview": "eas build -p android --profile preview",
    "submit:android": "eas submit -p android --profile production --latest",
    "submit:ios": "eas submit -p ios --profile production --latest",
    "doctor": "npx expo-doctor",
    "login": "eas login",
    "init": "eas init",
    "whoami": "eas whoami",
    "credentials": "eas credentials",
    "release": "eas build --platform all --profile production --auto-submit",
    "release:ios": "eas build --platform ios --profile production --auto-submit",
    "release:android": "eas build --platform android --profile production --auto-submit"
  },
  "private": true,
  "devDependencies": {
    "eas-cli": "^24.7.0"
  }
}
