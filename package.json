{
  "name": "adventskalender",
  "version": "1.0.0",
  "description": "Interaktiver, animierter Adventskalender – Admin-Dashboard + Beschenkten-Ansicht",
  "private": true,
  "main": "server/src/index.js",
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "concurrently -k -n CSS,SERVER -c yellow,cyan \"npm:dev:css\" \"npm:dev:server\"",
    "dev:server": "nodemon server/src/index.js",
    "dev:css": "tailwindcss -i ./src/input.css -o ./public/shared/styles.css --watch",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/shared/styles.css --minify",
    "setup": "node server/src/setup.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "gsap": "^3.12.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "mysql2": "^3.24.4",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.3",
    "socket.io": "^4.8.3",
    "stripe": "^22.6.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3"
  },
  "engines": {
    "node": ">=18"
  }
}
